# Aider's chat history and tag cache
.aider*

# macOS Finder metadata
.DS_Store

# Playwright
/vapor-app/test-results/
/vapor-app/playwright-report/
/vapor-app/blob-report/
/vapor-app/.playwright/

# Claude Code session state. The hooks and settings.json are versioned on
# purpose — the guard only works if every session gets it. Everything else
# here is per-session: worktrees are whole checkouts (152 MB of node_modules
# each) and the lock file is machine-local.
/.claude/worktrees/
/.claude/scheduled_tasks.lock
/.claude/*.local.json
/.claude/settings.local.json

# Playwright, run from the repo root instead of vapor-app/
/test-results/

# ts-rs output. `cargo test` without TS_RS_EXPORT_DIR writes the generated
# TypeScript here; the copies that count are checked in under
# vapor-app/src/lib/generated/ and compared by `npm run types:check`.
/vapor-app/src-tauri/bindings/
/vapor-core/bindings/
/vapor-core/crates/*/bindings/

# Left behind by the Godot build, deleted 2026-08-21. None of it is produced by
# anything here any more; these lines only keep a machine that once built that
# tree from showing untracked entries for ever.
#
# About 2 GB on the machine this was removed on: android/ 1.8 GB, godot-cpp/
# 240 MB (a deregistered submodule checkout), .godot/ 5.5 MB, .sconsign.dblite
# 5.4 MB, bin/ 808 KB, and three SCons object files in src/. Safe to delete:
#
#   rm -rf .godot bin external android godot-cpp src .sconsign.dblite
#
# Nothing regenerates them, and `godot-final-v1.78` has the sources.
.godot/
/android/
/bin/
/src/
/godot-cpp/
external/
.sconsign.dblite
