{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session-survey.sh\"",
            "timeout": 20,
            "statusMessage": "Looking at what the other sessions are doing"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-git-staging.sh\"",
            "timeout": 10,
            "statusMessage": "Checking the stage is yours"
          }
        ]
      }
    ]
  }
}
