{
  "name": "vapor-music",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run types:check && npm run build:web",
    "build:web": "tsc --noEmit && vite build && node scripts/verify-dist.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "tauri build && node scripts/make-icon.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "verify-dist": "node scripts/verify-dist.mjs",
    "mark": "node scripts/export-mark.mjs",
    "icon:macos": "node scripts/make-icon.mjs",
    "types:check": "node scripts/check-types.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "typescript": "^5",
    "vite": "^6",
    "vitest": "^4.1.10"
  }
}
